!(import! &self petta_chainer)

(= (RemovalHasAnswer $kb $type)
   (not (== (collapse (query 100 $kb (: $proof $type $tv))) ())))

(= (RemovalRule $name $premise $conclusion)
   (: $name
      (Implication
         (Premises $premise)
         (Conclusions $conclusion))
      (STV 1.0 1.0)))

; Facts are removed by source name and unrelated facts remain.
!(compileadd removalFactKb (: keepFact (KeepFact) (STV 1.0 1.0)))
!(compileadd removalFactKb (: dropFact (DropFact) (STV 0.8 0.9)))
!(test (RemovalHasAnswer removalFactKb (DropFact)) true)
!(test (remove-compiled-statement removalFactKb dropFact) 1)
!(test (RemovalHasAnswer removalFactKb (DropFact)) false)
!(test (RemovalHasAnswer removalFactKb (KeepFact)) true)
!(test (remove-compiled-statement removalFactKb dropFact) 0)

; Every source statement with the requested name is removed.
!(compileadd removalDuplicateKb (: duplicateName (FirstDuplicate) (STV 1.0 1.0)))
!(compileadd removalDuplicateKb (: duplicateName (SecondDuplicate) (STV 1.0 1.0)))
!(test (remove-compiled-statement removalDuplicateKb duplicateName) 2)
!(test (RemovalHasAnswer removalDuplicateKb (FirstDuplicate)) false)
!(test (RemovalHasAnswer removalDuplicateKb (SecondDuplicate)) false)

; Removing a rule clears its compiled rows, source implication index, and rule
; evidence while retaining its premise fact.
!(compileadd removalRuleKb (: ruleSeed (RuleSeed) (STV 1.0 1.0)))
!(compileadd removalRuleKb (RemovalRule removableRule (RuleSeed) (RuleGoal)))
!(test (RemovalHasAnswer removalRuleKb (RuleGoal)) true)
!(test (rule-evidence-registered? removalRuleKb removableRule) true)
!(test
   (not
      (==
         (collapse
            (match implication_index
               (removalRuleKb (RuleSeed) (RuleGoal) removableRule $_tv)
               true))
         ()))
   true)
!(test (remove-compiled-statement removalRuleKb removableRule) 1)
!(test (RemovalHasAnswer removalRuleKb (RuleGoal)) false)
!(test (RemovalHasAnswer removalRuleKb (RuleSeed)) true)
!(test (rule-evidence-registered? removalRuleKb removableRule) false)
!(test
   (collapse
      (match implication_index
         (removalRuleKb $_premise $_conclusion removableRule $_tv)
         true))
   ())

; Rules with negated conclusions are rebuilt from sources instead of removed by
; inspecting their compiled proof shape.
!(compileadd removalNegatedKb (: negatedSeed (NegatedSeed) (STV 1.0 1.0)))
!(compileadd removalNegatedKb
   (: removableNegatedRule
      (Implication
         (Premises (NegatedSeed))
         (Conclusions (Not (NegatedGoal))))
      (STV 1.0 1.0)))
!(test (RemovalHasAnswer removalNegatedKb (Not (NegatedGoal))) true)
!(test (remove-compiled-statement removalNegatedKb removableNegatedRule) 1)
!(test (RemovalHasAnswer removalNegatedKb (Not (NegatedGoal))) false)

; Generic variable-head rules and their wildcard index rows disappear together.
!(compileadd removalOpenHeadKb
   (: removableOpenHeadRule
      (Implication
         (Premises (RemovalSymmetric $relation) ($relation $left $right))
         (Conclusions ($relation $right $left)))
      (STV 1.0 1.0)))
!(compileadd removalOpenHeadKb
   (: removalSymmetricFriend (RemovalSymmetric Friend) (STV 1.0 1.0)))
!(compileadd removalOpenHeadKb
   (: removalFriendFact (Friend bob alice) (STV 1.0 1.0)))
!(test (RemovalHasAnswer removalOpenHeadKb (Friend alice bob)) true)
!(test
   (not
      (==
         (collapse
            (match ccls_head_index
               ((fwd_trigger removalOpenHeadKb any) $id)
               $id))
         ()))
   true)
!(test (remove-compiled-statement removalOpenHeadKb removableOpenHeadRule) 1)
!(test (RemovalHasAnswer removalOpenHeadKb (Friend alice bob)) false)
!(test
   (collapse
      (match ccls_head_index
         ((fwd_trigger removalOpenHeadKb any) $id)
         $id))
   ())

; Both directions generated by a bidirectional rule are removed.
!(compileadd removalBidirectionalKb (: bidirectionalSeed (BiA) (STV 1.0 1.0)))
!(compileadd removalBidirectionalKb
   (: removableBidirectional
      (BiImplication
         (Premises (BiA))
         (Conclusions (BiB)))
      (STV 1.0 1.0)))
!(test (RemovalHasAnswer removalBidirectionalKb (BiB)) true)
!(test (remove-compiled-statement removalBidirectionalKb removableBidirectional) 1)
!(test (RemovalHasAnswer removalBidirectionalKb (BiB)) false)
!(test (RemovalHasAnswer removalBidirectionalKb (BiA)) true)

; CPU-only aggregate rules are part of the rebuilt rule set.
(= (RemovalKeepAcc $acc $_elem) $acc)
!(compileadd removalAggregateKb
   (: removableAggregate
      (Implication
         (Premises
            (FoldAll (MissingRemovalValue $value)
               $value
               42
               RemovalKeepAcc
               ->
               $total))
         (Conclusions (RemovalTotal $total)))
      (STV 1.0 1.0)))
!(test (RemovalHasAnswer removalAggregateKb (RemovalTotal 42)) true)
!(test (remove-compiled-statement removalAggregateKb removableAggregate) 1)
!(test (RemovalHasAnswer removalAggregateKb (RemovalTotal 42)) false)

; Materialized descendants are invalidated. Remaining rules can derive them
; again after the seed is re-added.
!(compileadd removalDerivedKb (: derivedSeed (DerivedA) (STV 1.0 1.0)))
!(compileadd removalDerivedKb (RemovalRule derivedAtoB (DerivedA) (DerivedB)))
!(compileadd removalDerivedKb (RemovalRule derivedBtoC (DerivedB) (DerivedC)))
!(forward-chain 20 removalDerivedKb)
!(test (forward-has-derived? removalDerivedKb (DerivedC)) true)
!(test (remove-compiled-statement removalDerivedKb derivedSeed) 1)
!(test (forward-has-derived? removalDerivedKb (DerivedA)) false)
!(test (forward-has-derived? removalDerivedKb (DerivedB)) false)
!(test (forward-has-derived? removalDerivedKb (DerivedC)) false)
!(test (RemovalHasAnswer removalDerivedKb (DerivedC)) false)
!(compileadd removalDerivedKb (: derivedSeed (DerivedA) (STV 1.0 1.0)))
!(test (RemovalHasAnswer removalDerivedKb (DerivedC)) true)
!(forward-chain 20 removalDerivedKb)
!(test (forward-has-derived? removalDerivedKb (DerivedC)) true)

; Backward query materialization is invalidated by the same rebuild path.
!(compileadd removalQueryMaterializedKb
   (: queryMaterializedSeed (QueryMaterializedA) (STV 1.0 1.0)))
!(compileadd removalQueryMaterializedKb
   (RemovalRule queryMaterializedRule
      (QueryMaterializedA)
      (QueryMaterializedB)))
!(query-materialize 20 removalQueryMaterializedKb
   (: $proof (QueryMaterializedB) $tv))
!(test
   (forward-has-derived? removalQueryMaterializedKb (QueryMaterializedB))
   true)
!(test
   (remove-compiled-statement removalQueryMaterializedKb queryMaterializedSeed)
   1)
!(test
   (forward-has-derived? removalQueryMaterializedKb (QueryMaterializedB))
   false)
!(test
   (RemovalHasAnswer removalQueryMaterializedKb (QueryMaterializedB))
   false)

; Specialization templates and exact-emission markers are rebuilt with the KB.
!(set-specializing-predicate RemovalDeclaredRelation)
!(compileadd removalSpecializedKb
   (: removableSpecializedRule
      (Implication
         (Premises
            (RemovalDeclaredRelation $relation)
            ($relation $left $right))
         (Conclusions ($relation $right $left)))
      (STV 1.0 1.0)))
!(compileadd removalSpecializedKb
   (: removalFriendDeclaration
      (RemovalDeclaredRelation Friend)
      (STV 1.0 1.0)))
!(compileadd removalSpecializedKb
   (: specializedFriendFact (Friend right left) (STV 1.0 1.0)))
!(test (RemovalHasAnswer removalSpecializedKb (Friend left right)) true)
!(test (remove-compiled-statement removalSpecializedKb removalFriendDeclaration) 1)
!(test (RemovalHasAnswer removalSpecializedKb (Friend left right)) false)
!(test
   (collapse
      (match ccls_head_index
         ((fwd_trigger removalSpecializedKb Friend) $id)
         $id))
   ())
!(compileadd removalSpecializedKb
   (: removalFriendDeclaration
      (RemovalDeclaredRelation Friend)
      (STV 1.0 1.0)))
!(test (RemovalHasAnswer removalSpecializedKb (Friend left right)) true)
!(test (remove-compiled-statement removalSpecializedKb removableSpecializedRule) 1)
!(test (RemovalHasAnswer removalSpecializedKb (Friend left right)) false)

; A statement name is scoped by knowledge base.
!(compileadd removalIsolationLeftKb
   (: sharedRemovalName (LeftOnly) (STV 1.0 1.0)))
!(compileadd removalIsolationRightKb
   (: sharedRemovalName (RightOnly) (STV 1.0 1.0)))
!(test (remove-compiled-statement removalIsolationLeftKb sharedRemovalName) 1)
!(test (RemovalHasAnswer removalIsolationLeftKb (LeftOnly)) false)
!(test (RemovalHasAnswer removalIsolationRightKb (RightOnly)) true)

; Lower-level compiled rows survive a rebuild because they are recorded as raw
; source events rather than attributed to a compileadd statement.
!(add-to-kb
   ((RawPreserved)
      (removalRawKb MAIN Nil)
      rawPreservedProof
      (STV 1.0 1.0)))
!(collapse
   (foreach-flat add-to-kb
      (map-flat internalize-proof-structure
         (collapse
            (mm2compile removalRawKb
               (RemovalRule rawPreservedRule
                  (RawPreserved)
                  (RawRuleGoal)))))))
!(compileadd removalRawKb (: rawDropFact (RawDrop) (STV 1.0 1.0)))
!(test (RemovalHasAnswer removalRawKb (RawRuleGoal)) true)
!(test (remove-compiled-statement removalRawKb rawDropFact) 1)
!(test (RemovalHasAnswer removalRawKb (RawDrop)) false)
!(test (RemovalHasAnswer removalRawKb (RawPreserved)) true)
!(test (RemovalHasAnswer removalRawKb (RawRuleGoal)) true)

; Wildcard lookup rows tied to removed facts cannot outlive the source.
!(set-context-polymorphic-facts removalWildcardKb true)
!(compileadd removalWildcardKb
   (: removableWildcard (RemovalWildcard #) (STV 1.0 1.0)))
!(test
   (not
      (==
         (collapse
            (match wildcard_premise_index
               ($_key
                  (removalWildcardKb $_ctx $_vars)
                  $_type
                  removableWildcard
                  $_tv)
               true))
         ()))
   true)
!(test (remove-compiled-statement removalWildcardKb removableWildcard) 1)
!(test
   (collapse
      (match wildcard_premise_index
         ($_key
            (removalWildcardKb $_ctx $_vars)
            $_type
            removableWildcard
            $_tv)
         true))
   ())
!(test
   (collapse
      (match wildcard_premise_context
         ((removalWildcardKb $_ctx $_vars))
         true))
   ())

; Wrapped proof IDs are valid source names.
!(compileadd removalWrappedKb (: wrappedSeed (WrappedSeed) (STV 1.0 1.0)))
!(compileadd removalWrappedKb
   (RemovalRule (no_inverse wrappedRule) (WrappedSeed) (WrappedGoal)))
!(test (RemovalHasAnswer removalWrappedKb (WrappedGoal)) true)
!(test
   (remove-compiled-statement removalWrappedKb (no_inverse wrappedRule))
   1)
!(test (RemovalHasAnswer removalWrappedKb (WrappedGoal)) false)
